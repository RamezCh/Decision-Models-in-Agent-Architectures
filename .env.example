# Jev (TypeSafe). Get a key at https://console.typesafe.ai
TYPESAFE_API_KEY=
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# TYPESAFE_MODEL=jev-latest

# CLM-8B, served by `clm-serve` (default port 8700). Change the host if it runs on a GPU server.
CLM_BASE_URL=http://127.0.0.1:8700
# CLM_API_KEY=            # only if clm-serve was started with an API key
# CLM_MODEL=clm-latest

# Beat the guard: optional real LLM as the vault bot (any OpenAI-compatible server, e.g. vLLM or Ollama).
# Leave empty to use the deterministic scripted bot.
# VAULT_LLM_BASE_URL=http://127.0.0.1:8001/v1   (not 8000: that's the demo app)
# VAULT_LLM_MODEL=Qwen/Qwen3-8B
# VAULT_LLM_API_KEY=
# VAULT_SECRET=PISTACHIO
