# Jev (TypeSafe), used by the cube race. Get a key at https://console.typesafe.ai
TYPESAFE_API_KEY=
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# TYPESAFE_MODEL=jev-latest

# CLM-8B, served by `clm-serve`. On the cluster: keep 127.0.0.1 and run
#   kubectl -n vpdx3758 port-forward pod/clm 8700:8700     (see k8s/README.md)
CLM_BASE_URL=http://127.0.0.1:8700
# CLM_API_KEY=            # only if clm-serve was started with an API key
# CLM_MODEL=clm-latest

# Which models a demo asks (default: CLM only). Set to jev,clm to compare both.
# SCAM_MODELS=clm
# GUARD_MODELS=clm

# Chat LLM (System 2) for Vaulty and the optional "BHT Medium" cube player: BHT's LUMIS.
# The key is read from your ENVIRONMENT as BHT_LLM_INF_API_KEY. Do not put it in this file.
# Without it, Vaulty is the scripted bot and the LLM cube player reports "no API key".
# LLM_MODEL=bht/medium
# LLM_BASE_URL=     default: http://envoy-internal.envoy.svc.cluster.local/v1 inside the cluster,
#                   https://lumis-api.bht-berlin.de/v1 elsewhere; the other one is tried if the first fails
# VAULT_BOT=scripted    force the deterministic scripted bot
# VAULT_SECRET=PISTACHIO
